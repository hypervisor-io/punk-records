{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/punk hook --url http://localhost:9090 --ns proj-ns",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "echo hi && date",
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "/usr/local/bin/punk hook --url http://localhost:9090 --ns proj-ns",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "my-stop.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/usr/local/bin/punk hook --url http://localhost:9090 --ns proj-ns",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/punk hook --url http://localhost:9090 --ns proj-ns",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus"
}
